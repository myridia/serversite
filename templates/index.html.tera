<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{% if cfg.header.title %}{{ cfg.header.title | escape }}{% else %}Server{% endif %} &mdash; {{ cfg.header.description | default(value="") | escape }}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">

  <style>
    :root {
      --offcanvas-width: min(360px, 82vw);
      --transition-speed: 280ms;
    }

    .container { max-width: 100% !important; padding-inline: 2rem; }

    header.site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.5rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--pico-card-background-color);
    }

    [data-theme="light"] header.site-header,
    [data-theme="light"] footer.site-footer {
      background: #eef1f5;
    }

    nav.main-nav ul {
      display: flex;
      gap: 0.75rem;
      margin: 0;
      padding: 0;
      list-style: none;
      align-items: center;
    }

    .burger {
      display: none;
      background: transparent;
      border: none;
      font: inherit;
      cursor: pointer;
      align-items: center;
      gap: .5rem;
      text-decoration: none;
    }

    @media (max-width: 720px) {
      nav.main-nav { display: none; }
      .burger { display: inline-flex; }
    }

    html[data-theme="light"] .burger,
    html[data-theme="light"] .offcanvas__close {
      color: #222;
    }

    #menu {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 999;
    }

    #menu:target {
      pointer-events: auto;
    }

    .offcanvas__backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(2px);
      opacity: 0;
      transition: opacity var(--transition-speed) ease;
      pointer-events: none;
      z-index: 1000;
      text-decoration: none;
    }

    #menu:target .offcanvas__backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .offcanvas__panel {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: var(--offcanvas-width);
      max-width: 100%;
      background: var(--pico-card-background-color);
      box-shadow: 8px 0 28px rgba(0,0,0,0.16);
      transform: translateX(-100%);
      transition: transform var(--transition-speed) cubic-bezier(.2,.9,.25,1);
      z-index: 1001;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      display: flex;
      flex-direction: column;
      outline: none;
    }

    #menu:target .offcanvas__panel {
      transform: translateX(0);
    }

    .offcanvas__header {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: 1rem;
      border-bottom: 1px solid var(--pico-muted-border-color, rgba(128,128,128,0.2));
      flex: 0 0 auto;
    }

    .offcanvas__nav {
      padding: 1rem;
      overflow: auto;
    }

    .offcanvas__nav ul {
      display: flex;
      flex-direction: column;
      gap: .5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .offcanvas__close {
      margin-left: auto;
      background: transparent;
      border: none;
      cursor: pointer;
      font: inherit;
      padding: .25rem;
      text-decoration: none;
    }

    .offcanvas__panel a:focus {
      outline: 3px solid Highlight;
      outline-offset: 2px;
    }

    html { scroll-behavior: auto; }

    main.container { padding-top: 1rem; }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--pico-grid-gap, 1rem);
    }

    .service-grid article { text-align: center; transition: box-shadow .2s, transform .2s; }
    .service-grid article:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.15); transform: translateY(-2px); }
    .service-grid article h3 { margin-bottom: .25rem; }
    .service-grid article img { max-height: 2.5em; vertical-align: middle; margin-right: .25rem; }

    .contact-section { text-align: center; }
    .contact-section article { max-width: 600px; margin: 0 auto; }

    section > hgroup { margin-bottom: var(--pico-spacing); }

    table { margin: 0; }

    footer.site-footer {
      background: var(--pico-card-background-color);
      border-top: 1px solid var(--pico-muted-border-color);
      padding: 3rem 0 1.5rem;
      margin-top: 3rem;
    }

    footer.site-footer h5 {
      margin-bottom: .75rem;
    }

    footer.site-footer ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    footer.site-footer ul li + li {
      margin-top: .4rem;
    }

    footer.site-footer a {
      color: var(--pico-muted-color);
      text-decoration: none;
    }

    footer.site-footer a:hover {
      color: var(--pico-primary);
    }

    footer.site-footer .copyright {
      text-align: center;
      color: var(--pico-muted-color);
      font-size: .825rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--pico-muted-border-color);
    }
  </style>
</head>
<body>

<header class="site-header">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;width:100%">
    <a class="brand" href="#"><strong>{% if cfg.header.title %}{{ cfg.header.title | escape }}{% else %}Server{% endif %}</strong></a>

    <nav class="main-nav" role="navigation" aria-label="Primary">
      <ul>
        {% if cfg.header.nav %}{% for link in cfg.header.nav %}
        <li><a href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
        {% endfor %}{% endif %}
      </ul>
    </nav>

    <div style="margin-left:auto;display:flex;gap:.25rem;align-items:center;margin-right:.5rem">
      <a href="#light" onclick="localStorage.setItem('pico-theme','light');document.documentElement.setAttribute('data-theme','light')" title="Light mode" style="display:flex;padding:.25rem;border-radius:var(--pico-border-radius);color:var(--pico-color);text-decoration:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </a>
      <a href="#dark" onclick="localStorage.setItem('pico-theme','dark');document.documentElement.setAttribute('data-theme','dark')" title="Dark mode" style="display:flex;padding:.25rem;border-radius:var(--pico-border-radius);color:var(--pico-color);text-decoration:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </a>
      <a href="#auto" onclick="localStorage.removeItem('pico-theme');document.documentElement.removeAttribute('data-theme')" title="Auto mode" style="display:flex;padding:.25rem;border-radius:var(--pico-border-radius);color:var(--pico-color);text-decoration:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      </a>
    </div>

    <a class="burger" href="#menu" aria-controls="menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      Menu
    </a>
  </div>
</header>

<div id="menu" aria-hidden="false">
  <a class="offcanvas__backdrop" href="#" aria-label="Close menu"></a>

  <aside class="offcanvas__panel" role="dialog" aria-modal="true" aria-label="Primary navigation" tabindex="-1">
    <div class="offcanvas__header">
      <strong>Navigation</strong>
      <a class="offcanvas__close" href="#" aria-label="Close navigation" title="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M6 18L18 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </a>
    </div>

    <nav class="offcanvas__nav" aria-label="Mobile primary">
      <ul>
        {% if cfg.header.nav %}{% for link in cfg.header.nav %}
        <li><a href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
        {% endfor %}{% endif %}
      </ul>
    </nav>
  </aside>
</div>

<main class="container">

{% for key, val in cfg %}
  {% if key == "header" or key == "contact" or key == "footer" %}
  {% elif val is object %}
<section>
  <hgroup>
    <h2>{{ key | default(value="Section") | escape }}</h2>
  </hgroup>
  <article>
  {% if val.host %}
    <table>
    {% for k2, v2 in val %}
      <tr><th>{{ k2 | escape }}</th><td>{{ v2 | escape }}</td></tr>
    {% endfor %}
    </table>
  {% else %}
    <p>
    {% if val.name %}<strong>{{ val.name | escape }}</strong><br>{% endif %}
    {% if val.email %}Email: <a href="mailto:{{ val.email | escape }}">{{ val.email | escape }}</a><br>{% endif %}
    {% if val.url %}<a href="{{ val.url | escape }}">{{ val.url | escape }}</a><br><br>{% endif %}
    {% if val.address %}{% for line in val.address %}{{ line | escape }}<br>{% endfor %}{% endif %}
    {% if val.tel %}Tel: {{ val.tel | escape }}{% endif %}
    {% if val.privacy %}</p><p><small>{{ val.privacy | escape }}</small>{% endif %}
    </p>
  {% endif %}
  </article>
</section>

  {% else %}
<section>
  <hgroup>
    <h2>{{ key | default(value="Services") | escape }}</h2>
  </hgroup>
  <div class="service-grid">
  {% for item in val %}
    <a href="{{ item.link | escape }}" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;display:block">
    <article style="cursor:pointer">
      <h3>{% if item.image %}<img src="{{ item.image | escape }}" alt="{{ item.name | escape }}">{% elif item.icon %}{{ item.icon | safe }}{% endif %} {{ item.name | default(value="") | escape }}</h3>
      <p>{{ item.description | default(value="") | escape }}</p>
    </article>
    </a>
  {% endfor %}
  </div>
</section>
  {% endif %}
{% endfor %}

</main>

{% if cfg.contact %}
<section class="contact-section">
  <hgroup>
    <h2>Contact</h2>
  </hgroup>
  <article>
    {% if cfg.contact.text %}<p>{{ cfg.contact.text | escape }}</p>{% endif %}
    {% if cfg.contact.email %}<p><a href="mailto:{{ cfg.contact.email | escape }}" role="button">{{ cfg.contact.email | escape }}</a></p>{% endif %}
  </article>
</section>
{% endif %}

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div>
        <h5>{% if cfg.header.title %}{{ cfg.header.title | escape }}{% else %}Server{% endif %}</h5>
        <p style="color:var(--pico-muted-color);font-size:.875rem">{{ cfg.header.description | default(value="") | escape }}</p>
      </div>
      {% if cfg.header.nav %}
      <div>
        <h5>Links</h5>
        <ul>
        {% for link in cfg.header.nav %}
          <li><a href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
        {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% if cfg.contact %}
      <div>
        <h5>Contact</h5>
        <ul>
          {% if cfg.contact.email %}<li><a href="mailto:{{ cfg.contact.email | escape }}">{{ cfg.contact.email | escape }}</a></li>{% endif %}
        </ul>
      </div>
      {% endif %}
    </div>
    <div class="copyright">{% if cfg.header.title %}{{ cfg.header.title | escape }}{% else %}Server{% endif %}{% if cfg.footer.updated %} &middot; updated <time datetime="{{ cfg.footer.updated | escape }}">{{ cfg.footer.updated | escape }}</time>{% endif %}</div>
  </div>
</footer>

<script>
  (function() {
    var t = localStorage.getItem('pico-theme');
    if (t) document.documentElement.setAttribute('data-theme', t);
  })();
</script>

</body>
</html>
